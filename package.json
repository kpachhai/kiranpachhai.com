{
  "name": "kiranpachhai.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "gate:copy": "node scripts/gates/copy-scan.ts dist",
    "data": "node --import ./scripts/gates/ts-resolve.mjs scripts/data/fetch-github.ts",
    "gate:provenance": "node --import ./scripts/gates/ts-resolve.mjs scripts/gates/provenance.ts",
    "gates": "npm run build && npm test"
  },
  "dependencies": {
    "astro": "7.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "satori": "0.63.2",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
