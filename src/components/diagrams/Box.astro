---
// One node of a case-study diagram: a box with a label and an optional second line.
// i orders the draw-in (50 ms apart).
interface Props {
  i: number
  x: number
  y: number
  w: number
  h: number
  label: string
  sub?: string
  em?: boolean
}

const { i, x, y, w, h, label, sub, em = false } = Astro.props
const cx = x + w / 2
const cy = y + h / 2
---

<g class="nd" style={`--i:${i}`}>
  <rect class:list={['bx', { em }]} x={x} y={y} width={w} height={h} />
  <text x={cx} y={sub ? cy - 2 : cy + 3.5}>{label}</text>
  {sub && <text class="sm" x={cx} y={cy + 10}>{sub}</text>}
</g>
