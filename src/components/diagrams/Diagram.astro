---
// Frame for a case-study diagram: inline SVG named by its label, drawn in the plan style.
// Two drawings of the same diagram: a wide one (360 units across) and, below 720 px, a narrow one
// (240 units across, stacked) so text stays at least 11 px for labels and 10 px for second lines
// on a 390 px phone. Only one is displayed, so assistive tech meets one image.
// The colours come from the --s-* tokens (the plan values, in src/styles/tokens.css). Nodes and
// edges draw in when the figure enters the viewport; under reduced motion, or without JavaScript,
// the settled drawing shows at once.
interface Props {
  slug: string
  label: string
  wideHeight: number
  narrowHeight: number
}

const { slug, label, wideHeight, narrowHeight } = Astro.props
---

<figure class="dg">
  <svg class="dg-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <marker id="dg-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L8 4L0 8z" />
      </marker>
    </defs>
  </svg>
  <svg class="dg-w" viewBox={`0 0 360 ${wideHeight}`} role="img" aria-label={label} data-diagram={slug}>
    <slot name="wide" />
  </svg>
  <svg class="dg-n" viewBox={`0 0 240 ${narrowHeight}`} role="img" aria-label={label} data-diagram={slug}>
    <slot name="narrow" />
  </svg>
</figure>

<script>
  import { prefersReducedMotion } from '../../island/motion'

  // Arm each diagram (hide its parts) only when the draw-in can actually run.
  if (!prefersReducedMotion() && 'IntersectionObserver' in window) {
    for (const figure of document.querySelectorAll<HTMLElement>('figure.dg')) {
      figure.classList.add('armed')
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return
          figure.classList.add('in')
          observer.disconnect()
        },
        { threshold: 0.3 },
      )
      observer.observe(figure)
    }
  }
</script>

<style is:global>
  .dg { --s-faint: color-mix(in srgb, var(--s-line) 8%, transparent); margin: 28px 0 8px; max-width: 640px; padding: 10px; background-color: var(--s-ground); color: var(--s-ink); border: 1px solid var(--rule);
    background-image: linear-gradient(var(--s-faint) 1px, transparent 1px), linear-gradient(90deg, var(--s-faint) 1px, transparent 1px); background-size: 16px 16px; }
  .dg svg { display: block; width: 100%; height: auto; }
  .dg .dg-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .dg .dg-n { display: none; }
  @media (max-width: 719px) {
    .dg { max-width: 440px; }
    .dg .dg-w { display: none; }
    .dg .dg-n { display: block; }
  }
  .dg .bx { fill: var(--s-ground); stroke: var(--s-line); stroke-width: 1.4; }
  .dg .bx.em { stroke: var(--s-acc); stroke-width: 2; }
  .dg .lk { fill: none; stroke: var(--s-line); stroke-width: 1.4; }
  .dg .lk.alt { stroke-dasharray: 4 3; }
  .dg .lk.acc { stroke: var(--s-acc); }
  .dg marker path { fill: var(--s-line); }
  .dg text { font-family: var(--s-font); font-size: 10.5px; fill: var(--s-ink); text-anchor: middle; }
  .dg text.sm { font-size: 8.5px; fill: var(--s-muted); }
  .dg text.lft { text-anchor: start; }
  .dg text.rgt { text-anchor: end; }
  .dg text { text-transform: uppercase; font-stretch: 80%; font-weight: 700; letter-spacing: 0.02em; }
  .dg text.sm { font-weight: 500; text-transform: none; letter-spacing: 0; }
  /* Narrow drawing: sizes in its 240-unit space; at 390 px it scales by 1.4. */
  .dg .dg-n text { font-size: 8.5px; }
  .dg .dg-n text.sm { font-size: 7.5px; }

  /* Draw-in: nodes rise in 50 ms apart, then edges trace and their labels fade in. */
  @media (prefers-reduced-motion: no-preference) {
    .dg.armed:not(.in) .nd, .dg.armed:not(.in) .lk, .dg.armed:not(.in) .el { opacity: 0; }
    .dg.in .nd { animation: dg-rise 800ms var(--ease) backwards; animation-delay: calc(var(--i) * 50ms); }
    .dg.in .lk { animation: dg-trace 700ms var(--ease) backwards; animation-delay: calc(var(--i) * 50ms + 300ms); }
    .dg.in .el { animation: dg-fade 400ms var(--ease) backwards; animation-delay: calc(var(--i) * 50ms + 600ms); }
  }
  @keyframes dg-rise { from { opacity: 0; transform: translateY(6px); } }
  @keyframes dg-trace { 0% { opacity: 0; stroke-dasharray: 0 400; } 15% { opacity: 1; } 100% { stroke-dasharray: 400 0; } }
  @keyframes dg-fade { from { opacity: 0; } }
</style>
