---
// Mounts the island on the static hero: the sticky bar, the proof drawer, the palette and the data
// they read. Everything here is hidden without JavaScript; the static list in #stage stays the page.
import { model } from '../../model'
import { buildIslandData, DATA_ELEMENT_ID, serialiseIslandData } from '../../island/data'
import { LENSES, DEFAULT_LENS } from '../../island/state'
import '../../island/lenses/lenses.css'

const LENS_NAMES: Record<(typeof LENSES)[number], string> = {
  plan: 'Plan',
  terrain: 'Terrain',
  console: 'Console',
  index: 'Index',
  range: 'Range',
}
const islandData = serialiseIslandData(buildIslandData(model))
---

<header class="bar js-only">
  <div class="wrap bar-in">
    <span class="mark" aria-hidden="true">KP</span>
    <div class="lenses" role="group" aria-label="Lens">
      {
        LENSES.map((lens, position) => (
          <button type="button" data-lens-button={lens} aria-pressed={String(lens === DEFAULT_LENS)}>
            {LENS_NAMES[lens]} <kbd>{position + 1}</kbd>
          </button>
        ))
      }
    </div>
    <button class="tool" type="button" id="palette-open" aria-haspopup="dialog" aria-controls="palette">
      Search <span class="hint">Ctrl K</span>
    </button>
    <button class="tool" type="button" id="theme-toggle">Theme: system</button>
  </div>
</header>

<aside class="drawer js-only" id="drawer" data-modal role="dialog" aria-modal="true" aria-labelledby="drawer-title" inert>
  <div class="dr-top">
    <span class="eyebrow" data-drawer-eyebrow></span>
    <button class="tool" type="button" data-drawer-close>Close</button>
  </div>
  <h2 id="drawer-title" tabindex="-1"></h2>
  <div data-drawer-body></div>
  <div class="dr-nav" data-drawer-nav>
    <button class="tool" type="button" data-step="prev">Previous domain</button>
    <button class="tool" type="button" data-step="next">Next domain</button>
  </div>
</aside>

<div class="pal js-only" id="palette" data-modal hidden>
  <div class="pal-box" role="dialog" aria-modal="true" aria-label="Search the map">
    <input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      aria-label="Search the map"
      placeholder="Search domains, proof, methods, materials, lenses"
      autocomplete="off"
      spellcheck="false"
    />
    <ul id="palette-list" role="listbox" aria-label="Results"></ul>
    <p class="pal-foot">Up and down to move, Enter to open, Esc to close. Try "mode: teach" or "kp terrain".</p>
  </div>
</div>

<p class="sr-only" id="island-live" data-live role="status" aria-live="polite"></p>
<script type="application/json" id={DATA_ELEMENT_ID} set:html={islandData} />

<script>
  import '../../island/main'
</script>

<style is:global>
  html:not(.js) .js-only { display: none !important; }

  .tool { border: 1px solid var(--control-line); background: transparent; color: inherit; padding: 7px 10px; font-family: var(--mono); font-size: 0.75rem; cursor: pointer; }
  .tool:hover { border-color: var(--ink); }

  .bar { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 30; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .bar-in { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; padding-block: 10px; }
  .bar .mark { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.06em; margin-right: auto; }
  .bar .hint { color: var(--muted); }
  .lenses { display: inline-flex; border: 1px solid var(--ink); }
  .lenses button { border: 0; background: transparent; color: inherit; padding: 7px 12px; font-family: var(--mono); font-size: 0.75rem; cursor: pointer; display: inline-flex; gap: 6px; align-items: baseline; justify-content: center; }
  .lenses button + button { border-left: 1px solid var(--ink); }
  .lenses button:hover { background: color-mix(in srgb, var(--ink) 7%, transparent); }
  .lenses kbd { font: inherit; font-size: 0.625rem; color: var(--muted); }
  .lenses button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .lenses button[aria-pressed="true"] kbd { color: inherit; opacity: 0.7; }


  .drawer { position: fixed; z-index: 40; top: 0; right: 0; bottom: 0; width: min(430px, 100vw); overflow-y: auto; overscroll-behavior: contain;
    background: var(--panel); color: var(--ink); border-left: 1px solid var(--rule); box-shadow: -18px 0 40px -30px rgba(0, 0, 0, 0.45);
    padding: 20px max(22px, env(safe-area-inset-right, 0px)) calc(24px + env(safe-area-inset-bottom, 0px)) 24px;
    transform: translateX(102%); visibility: hidden; transition: transform 520ms var(--ease), visibility 0s linear 520ms; }
  .drawer.open { transform: none; visibility: visible; transition: transform 520ms var(--ease), visibility 0s; }
  .drawer h2 { font-size: 2.125rem; line-height: 1; font-weight: 720; font-stretch: 82%; margin: 6px 0 14px; outline: none; }
  .dr-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .dr-sec { border-top: 1px solid var(--rule); padding-top: 12px; margin-top: 16px; }
  .dr-sec h3 { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-weight: 500; margin-bottom: 8px; }
  .dr-proofs { list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 2px solid var(--accent); display: grid; gap: 10px; font-size: 1rem; }
  .dr-proofs li { display: grid; gap: 2px; }
  .dr-proofs a, .dr-proofs b { font-weight: 600; }
  .dr-proofs span { color: var(--muted); font-size: 0.95rem; line-height: 1.4; }
  .dr-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { font-family: var(--mono); font-size: 0.6875rem; border: 1px solid var(--control-line); padding: 3px 8px; }
  .chip i { font-style: normal; color: var(--accent); font-weight: 600; margin-right: 6px; }
  .dr-up, .dr-domains { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 0.95rem; }
  .dr-up li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: baseline; }
  .dr-domains { display: flex; flex-wrap: wrap; }
  .dr-nav { display: flex; justify-content: space-between; gap: 10px; margin-top: 20px; }
  .dr-nav[hidden] { display: none; }
  @media (min-width: 720px) {
    /* The side sheet opens below the sticky bar so the lens switcher stays reachable. */
    .drawer { top: calc(var(--bar-h, 64px) + env(safe-area-inset-top, 0px)); }
  }
  @media (max-width: 719px) {
    .bar-in { gap: 8px 12px; }
    .lenses { order: 3; width: 100%; }
    .lenses button { flex: 1 1 0; min-width: 0; padding: 7px 4px; }
    .lenses kbd { display: none; }
    .drawer { top: auto; left: 0; width: auto; max-height: 78vh; border-left: 0; border-top: 1px solid var(--rule); transform: translateY(102%);
      padding-left: max(18px, env(safe-area-inset-left, 0px)); padding-right: max(18px, env(safe-area-inset-right, 0px)); box-shadow: 0 -18px 40px -30px rgba(0, 0, 0, 0.5); }
    .drawer h2 { font-size: 1.75rem; }
  }

  .pal { position: fixed; inset: 0; z-index: 50; background: color-mix(in srgb, var(--ink) 35%, transparent); display: grid; align-items: start; justify-items: center; padding: 12vh 16px 16px; }
  .pal[hidden] { display: none; }
  .pal-box { width: min(560px, 100%); background: var(--paper); color: var(--ink); border: 1px solid var(--ink); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.5); }
  .pal input { width: 100%; border: 0; border-bottom: 1px solid var(--control-line); background: transparent; color: var(--ink); padding: 14px 16px; font-family: var(--mono); font-size: 0.9375rem; outline: none; }
  .pal ul { list-style: none; margin: 0; padding: 6px 0; max-height: 50vh; overflow-y: auto; }
  .pal li { display: grid; grid-template-columns: 8ch minmax(0, 1fr) auto; gap: 10px; padding: 8px 16px; cursor: pointer; font-size: 0.9375rem; align-items: baseline; }
  .pal li .k, .pal li .h { font-family: var(--mono); font-size: 0.65rem; color: var(--muted); }
  .pal li .k { letter-spacing: 0.06em; text-transform: uppercase; }
  .pal li[aria-selected="true"] { background: var(--ink); color: var(--paper); }
  .pal li[aria-selected="true"] .k, .pal li[aria-selected="true"] .h { color: inherit; opacity: 0.75; }
  .pal li.empty { display: block; cursor: default; color: var(--muted); }
  .pal-foot { margin: 0; border-top: 1px solid var(--rule); padding: 8px 16px; font-family: var(--mono); font-size: 0.65rem; color: var(--muted); }
  @media (max-width: 719px) {
    .pal { align-items: end; padding: 0; }
    .pal-box { width: 100%; border-width: 1px 0 0; padding-bottom: env(safe-area-inset-bottom, 0px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer, .drawer.open { transition: none; }
  }
</style>
