---
// The no-JS hero: identity, the site-plan sheet, and under it the static proof list each summit
// links to. With JavaScript the list is hidden and the island adds behaviour to the sheet.
import { cycleTitles, model } from '../../model'
import { languages, proofsInDomain, upstreamIn } from '../../lib/site'
import { STATUS_LABELS } from '../../model/labels'
import { pad } from '../../island/format'
import SourceTag from '../SourceTag.astro'
import Sheet from '../sheet/Sheet.astro'

const SECTIONS: [string, string][] = [
  ['#work', 'Selected work'],
  ['#methods', 'How I work'],
  ['#journey', 'Journey'],
  ['#range', 'Range'],
  ['#timeline', 'Timeline'],
  ['#upstream', 'Upstream'],
  ['#talks', 'Talks and teaching'],
]
---

<header class="hero wrap">
  <h1 class="name">{model.hero.name}<span class="dot" aria-hidden="true">.</span></h1>
  <div class="intro" data-claim-id="hero">
    <div class="role-box" id="role-box" data-role-box>
      <p class="role">{model.hero.roleLine}</p>
    </div>
    <p class="roles-held"><span class="eyebrow">Roles held</span> <span>{cycleTitles.join(', ')}</span></p>
    <p class="thesis">{model.hero.thesis}</p>
    <SourceTag source={model.hero.source} />
    <p class="langs">
      <span class="eyebrow">Primary languages</span>
      {languages.map((name) => <span class="lang">{name}</span>)}
    </p>
  </div>
  <nav class="jump" aria-label="Sections">
    {SECTIONS.map(([href, label]) => <a href={href}>{label}</a>)}
  </nav>
</header>

<section id="stage" class="stage" aria-labelledby="stage-h">
  <div class="wrap">
    <h2 id="stage-h" class="sr-only">Areas of work and their proof</h2>
    <Sheet />
    <ol class="index">
      {
        model.domains.map((domain, position) => {
          const proofs = proofsInDomain(domain.id)
          return (
            <li class="entry" id={`area-${domain.id}`} data-domain={domain.id}>
              <h3 class="entry-name">
                <span class="num" aria-hidden="true">{pad(position + 1)}</span>
                {domain.name}
              </h3>
              <ul class="proofs">
                {proofs.map((proof) => (
                  <li data-claim-id={`proof-${proof.id}`}>
                    {proof.href ? <a href={proof.href}>{proof.label}</a> : <span class="label">{proof.label}</span>}
                    <span class="detail">{proof.detail}</span>
                    <SourceTag source={proof.source} />
                  </li>
                ))}
              </ul>
              {upstreamIn(domain.id).length > 0 && (
                <div class="up-links" data-upstream={domain.id}>
                  <h4 class="up-h">Upstream</h4>
                  <ul>
                    {upstreamIn(domain.id).map((row) => (
                      <li>
                        <a href={row.href}>{row.label}</a>{' '}
                        <span class="up-st">{row.statuses.map((status) => STATUS_LABELS[status]).join(', ')}</span>
                        {row.links.length > 0 && (
                          <ul class="up-pins">
                            {row.links.map((link) => (
                              <li>
                                <a href={link.href}>{link.note}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          )
        })
      }
    </ol>
  </div>
</section>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px 48px; align-items: end; padding-block: 40px 16px; }
  .name { font-size: clamp(2.6rem, 7vw, 5rem); line-height: 0.92; font-weight: 750; font-stretch: 82%; letter-spacing: 0.005em; }
  .dot { color: var(--accent); }
  /* 26.06em is 46ch of Newsreader. Not ch itself: ch is the "0" of whichever face is drawing, so the
     measure jumped from 8.8 to 10 px a ch when Newsreader replaced the fallback and the role line
     rewrapped from three lines to two. The roles held are mono, whose fallback matches its advance. */
  .intro p { margin: 0 0 12px; max-width: 26.06em; }
  .intro .roles-held { max-width: 46ch; }
  .role { font-size: 1.1rem; }
  /* The role cycle plays in an overlay on the real line, which keeps its box and its place in the
     accessibility tree; opacity (not visibility) hides it so screen readers still read it. */
  .role-box { position: relative; }
  .role-box[data-cycling] .role { opacity: 0; }
  .role-box :global(.role-cycle) { position: absolute; left: 0; top: 0; right: 0; opacity: 0; pointer-events: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    font-family: var(--display); font-stretch: 82%; font-weight: 680; font-size: 1.25rem; line-height: 1.3; color: var(--ink); }
  /* The roles held are listed statically when the line does not cycle: no JavaScript, reduced motion,
     or a later page in the session (the cycle plays once; Base.astro marks it before first paint). */
  .roles-held { display: none; font-family: var(--mono); font-size: 0.75rem; line-height: 1.6; color: var(--muted); }
  .roles-held .eyebrow { margin-right: 6px; }
  :global(html:not(.js)) .roles-held, :global(html[data-roles-seen]) .roles-held { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .roles-held { display: block; }
  }
  /* 22em keeps the line count the same in every face: the italic needs 27.5em on one line and the
     slanted-regular stand-in 31.4em, so both set as two lines and a late italic moves nothing. */
  .intro .thesis { font-style: italic; color: var(--muted); max-width: 22em; text-wrap: balance; }
  .langs { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 8px; }
  .lang { font-family: var(--mono); font-size: 0.75rem; border: 1px solid var(--rule); padding: 2px 8px; }
  .jump { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px 18px; font-family: var(--mono); font-size: 0.75rem; padding-top: 12px; border-top: 1px solid var(--rule); }
  .stage { background: var(--paper); color: var(--s-ink); padding-block: 24px 32px; border-block: 1px solid var(--rule); }
  .index { list-style: none; margin: 24px 0 0; padding: 0; }
  /* With JavaScript the summits and the readout show the same content, so the list is not repeated.
     It is hidden from first paint, so a reader who followed a deep link below it is never moved by it
     collapsing late. An island that fails to start marks itself failed, and a module that fails to
     load drops the js class (Base.astro): either way the list shows, and each summit links to it. */
  :global(html.js:not([data-island="failed"])) #stage .index { display: none; }
  .entry { padding-block: 18px; border-bottom: 1px solid var(--rule); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 8px 32px; }
  .entry:last-child { border-bottom: 0; }
  .entry-name { font-size: 2.75rem; line-height: 1.02; font-weight: 700; font-stretch: 82%; letter-spacing: 0.004em; overflow-wrap: break-word; }
  .num { display: block; font-family: var(--mono); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.08em; color: var(--s-muted); margin-bottom: 6px; }
  .proofs { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-family: var(--body); }
  .proofs li { display: grid; gap: 2px; }
  .proofs a, .label { font-weight: 600; color: var(--s-acc); }
  .label { color: var(--s-ink); }
  .detail { font-size: 0.95rem; color: var(--s-muted); line-height: 1.4; }
  /* The curated upstream links per area. With JavaScript they move into the area's readout instead. */
  .up-links { grid-column: 2; font-family: var(--body); }
  .up-h { font-family: var(--mono); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--s-muted); margin: 4px 0 6px; }
  .up-links ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .up-links a { color: var(--s-acc); overflow-wrap: anywhere; }
  /* Several statuses wrap between words, so a long status list never widens the page at 200% text. */
  .up-st { font-family: var(--mono); font-size: 0.6875rem; color: var(--s-muted); }
  .up-links .up-pins { gap: 2px; margin-top: 2px; padding-left: 12px; border-left: 1px solid var(--rule); font-size: 0.95rem; }
  @media (max-width: 899px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 719px) {
    .entry { grid-template-columns: minmax(0, 1fr); }
    .entry-name { font-size: 1.6875rem; }
    .up-links { grid-column: 1; }
  }
</style>
