---
// Exactly four exits: no email, no location, no form. The theme control sits
// here on every page that has no island bar; the home page's bar carries the same control, so it
// is not repeated. It needs JavaScript, so it is hidden without it.
// The gates line comes from src/data/gates.json, written by `npm run gates` only after every gate
// passes; before the first full pass the file is absent and the line is left out.
import { parseGates } from '../../lib/gates'

const recorded = Object.values(import.meta.glob('../../data/gates.json', { eager: true, import: 'default' }))
const gates = recorded.length > 0 ? parseGates(recorded[0]) : null
---

<footer class="site-footer">
  <div class="wrap">
    <span>Kiran Pachhai</span>
    <nav aria-label="Elsewhere">
      <a href="https://github.com/kpachhai">GitHub</a>
      <a href="https://www.linkedin.com/in/kiranpachhai">LinkedIn</a>
      <a href="https://www.youtube.com/channel/UCu1XxDJE84ZvgLJ-EssbveA">YouTube</a>
      <a href="https://twitter.com/mr_pachhai">X</a>
    </nav>
    {gates && <p class="gates">Passed {gates.passed} of {gates.total} gates on <time datetime={gates.date}>{gates.date}</time></p>}
    <div class="settings" role="group" aria-label="Settings">
      <button type="button" data-theme-control>Theme: system</button>
    </div>
  </div>
</footer>

<script>
  import '../../island/settings'
</script>

<style>
  .site-footer { margin-top: 64px; border-top: 1px solid var(--ink); font-family: var(--mono); font-size: 0.75rem; }
  .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; padding-block: 18px 40px; }
  nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .gates { margin: 0; flex-basis: 100%; color: var(--muted); }
  .settings { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 8px; }
  .settings button { border: 1px solid var(--control-line); background: transparent; color: inherit; padding: 7px 10px; font: inherit; cursor: pointer; }
  .settings button:hover { border-color: var(--ink); }
  :global(html:not(.js)) .settings, :global(html:has(header.bar)) .settings { display: none; }
</style>
