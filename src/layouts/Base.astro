---
import '../styles/global.css'
import Footer from '../components/sections/Footer.astro'
import { model } from '../model'

interface Props {
  title: string
  description: string
  path: string
  ogImage: string
  canonical?: string
  noindex?: boolean
  jsonLd?: Record<string, unknown>
}

const { title, description, path, ogImage, noindex = false, jsonLd } = Astro.props
const canonical = new URL(Astro.props.canonical ?? path, Astro.site).href
const image = new URL(ogImage, Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Before first paint: mark JS as present and apply a stored theme and provenance choice. Storage can throw.
      // If a module script fails to load (blocked, offline), the page falls back to its no-JS view, so
      // no control is left on screen without the code behind it.
      ;(function () {
        var root = document.documentElement
        root.classList.add('js')
        window.addEventListener(
          'error',
          function (event) {
            var target = event.target
            if (target && target.tagName === 'SCRIPT' && target.type === 'module') root.classList.remove('js')
          },
          true,
        )
        // The island starts before the load event. One that loaded but never got ready (it threw while
        // its module was evaluated, or never ran) is marked failed, so the page shows its static list.
        window.addEventListener('load', function () {
          if (document.getElementById('island-data') && root.getAttribute('data-island') !== 'ready') root.setAttribute('data-island', 'failed')
        })
        try {
          var theme = window.localStorage.getItem('kp-theme')
          if (theme === 'light' || theme === 'dark') root.setAttribute('data-theme', theme)
          if (window.localStorage.getItem('kp-provenance') === 'on') root.setAttribute('data-provenance', 'on')
          // The hero's role cycle plays once a session; after that the roles are listed as text.
          if (window.sessionStorage.getItem('kp-roles-seen') === '1') root.setAttribute('data-roles-seen', '')
        } catch (error) {}
      })()
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={model.hero.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    {noindex && <meta name="robots" content="noindex" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin-wght-wdth82-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <script is:inline nomodule>document.documentElement.classList.remove('js')</script>
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
