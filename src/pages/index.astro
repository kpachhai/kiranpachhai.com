---
import Base from '../layouts/Base.astro'
import HeroStatic from '../components/hero/HeroStatic.astro'
import Stage from '../components/hero/Stage.astro'
import SelectedWork from '../components/sections/SelectedWork.astro'
import HowIWork from '../components/sections/HowIWork.astro'
import RangeMatrix from '../components/sections/RangeMatrix.astro'
import Timeline from '../components/sections/Timeline.astro'
import Upstream from '../components/sections/Upstream.astro'
import Talks from '../components/sections/Talks.astro'
import { model } from '../model'
import { PERSON, SITE_DESCRIPTION } from '../lib/site'
---

<Base title={model.hero.name} description={SITE_DESCRIPTION} path="/" ogImage="/og/home.png" jsonLd={PERSON}>
  <Stage />
  <main>
    <HeroStatic />
    <SelectedWork />
    <HowIWork />
    <RangeMatrix />
    <Timeline />
    <Upstream />
    <Talks />
  </main>
</Base>
